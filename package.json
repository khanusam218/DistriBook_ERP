{
  "name": "thok-software-erp",
  "version": "1.0.0",
  "description": "Thok Software ERP - Wholesale Business Management",
  "main": "electron/main.js",
  "author": "Thok Software",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "electron": "electron .",
    "build-frontend": "cd frontend && npm run build",
    "obfuscate-backend": "node scripts/obfuscate-backend.js",
    "dist": "npm run build-frontend && npm run obfuscate-backend && electron-builder --win --publish=never"
  },
  "build": {
    "appId": "com.thoksoftware.erp",
    "productName": "Thok Software ERP",
    "copyright": "Copyright © 2025 Thok Software",
    "asar": true,
    "directories": {
      "output": "dist-installer",
      "buildResources": "electron"
    },
    "files": [
      "electron/**/*",
      { "from": "backend-obfuscated/src", "to": "backend/src", "filter": ["**/*"] },
      "backend/package.json",
      "public/**/*"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "databases",
        "filter": [
          "*.db"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Thok Software ERP",
      "deleteAppDataOnUninstall": false,
      "differentialPackage": false
    }
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.0",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "javascript-obfuscator": "^5.4.3"
  },
  "allowScripts": {
    "electron@28.3.3": true
  }
}
